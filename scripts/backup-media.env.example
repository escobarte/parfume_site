# Шаблон env-файла для scripts/backup-media.sh — выгрузка в Backblaze B2.
#
# На сервере — положить копию по пути /etc/monflacon-backup.env (или другому,
# указанному через ENV_FILE), заполнить реальными значениями и обязательно:
#   sudo chmod 600 /etc/monflacon-backup.env
#   sudo chown root:root /etc/monflacon-backup.env
# Файл содержит секреты — в репозиторий не добавляется (сам этот .example —
# можно, он только плейсхолдеры).
#
# Бакет и ключ создаются один раз в консоли Backblaze B2 (Application Keys →
# Add a New Application Key, Bucket: monflacon-backups, Read and Write).

# Путь в бакете, куда класть архивы медиа. Пусто = выгрузка в B2 пропускается.
B2_REMOTE_PATH=monflacon-backups/media

# keyID и applicationKey из Backblaze B2 (Application Keys).
B2_KEY_ID=CHANGEME_b2_key_id
B2_APP_KEY=CHANGEME_b2_application_key

# Сколько архивов хранить в B2. По умолчанию (если не задано) — равно RETENTION.
RETENTION_REMOTE=14
