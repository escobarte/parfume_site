# Скопировать в .env и заполнить. Реальный .env никогда не коммитится.
# Правило: dev- и prod-секреты не пересекаются ни одним значением.

# Postgres (см. docker-compose.dev.yml)
DATABASE_URI=postgres://parfume:parfume@localhost:5432/parfume_dev

# Подпись сессий Payload — генерировать: openssl rand -hex 32
PAYLOAD_SECRET=CHANGEME_openssl_rand_hex_32

# Абсолютные URL приложения
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-совместимое хранилище медиа (прод — Cloudflare R2; в dev не используется, медиа хранится на диске)
S3_ENDPOINT=CHANGEME_s3_endpoint
S3_ACCESS_KEY=CHANGEME_s3_access_key
S3_SECRET_KEY=CHANGEME_s3_secret_key
S3_BUCKET=CHANGEME_s3_bucket

# Telegram-бот для заявок (BotFather)
TELEGRAM_BOT_TOKEN=CHANGEME_telegram_bot_token
TELEGRAM_CHAT_ID=CHANGEME_telegram_chat_id

# Email-уведомления о заявках (Resend)
RESEND_API_KEY=CHANGEME_resend_api_key
ORDER_EMAIL_TO=CHANGEME_order_email_to

# 1 — глушит внешние отправки (Telegram/email) для дев/тестов; 0 — прод
ORDERS_DRY_RUN=1

# GA4 Measurement ID
NEXT_PUBLIC_GA_ID=CHANGEME_ga_measurement_id

# Sentry DSN
SENTRY_DSN=CHANGEME_sentry_dsn

# Локальный админ, создаётся скриптом pnpm seed
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=CHANGEME_LOCAL_ADMIN_PASSWORD

# Сколько заявок с одного IP за 10 минут (по умолчанию 5)
ORDERS_RATE_LIMIT=5

# ── Режим «Сайт в разработке» (фаза 9.2) ──────────────────────────────────
# 1 — витрина закрыта заглушкой; 0 (или пусто) — сайт работает как обычно.
# /admin и /api остаются доступны в обоих режимах.
MAINTENANCE_MODE=0
# Секрет для байпаса: заход на https://<домен>/?preview=<токен> ставит cookie
# mf_preview на 30 дней и открывает нормальный сайт. Генерировать:
# openssl rand -hex 16 (32 символа). ПУСТОЕ значение при MAINTENANCE_MODE=1 =
# байпас невозможен ни для кого (fail closed) + предупреждение в логе на старте.
MAINTENANCE_BYPASS_TOKEN=CHANGEME_maintenance_bypass_token
# Соцсети на заглушке. Пустая переменная = кнопки нет вовсе (без дырки в вёрстке).
# NEXT_PUBLIC_* подставляются на СБОРКЕ: изменение требует полного redeploy,
# перезапуска контейнера мало.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/monflacon.md/
NEXT_PUBLIC_SOCIAL_TIKTOK=
