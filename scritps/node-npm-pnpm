bash <<'SETUP'
set -e

echo "==> [1/4] Установка nvm..."
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash

echo "==> Подключение nvm в текущую сессию..."
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

echo "==> [2/4] Установка Node 22..."
nvm install 22
nvm alias default 22

echo "==> [3/4] Включение pnpm через corepack..."
corepack enable
corepack prepare pnpm@latest --activate

echo ""
echo "==> [4/4] Проверка версий:"
echo "node: $(node -v)"
echo "npm:  $(npm -v)"
echo "pnpm: $(pnpm -v)"
echo ""
echo "==> Готово."
SETUP

---
source ~/.bashrc

--
node -v && pnpm -v